Bootstrap: docker
From: ubuntu:24.04

%labels
    Description "ns-3 with LeoSim routing scenario and TLE preprocessing"

%files
    . /opt/leosim

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get -o APT::Sandbox::User=root update
    apt-get -o APT::Sandbox::User=root install -y --no-install-recommends \
        build-essential ca-certificates cmake git ninja-build pkg-config \
        python3 python3-pip python3-venv \
        libsqlite3-dev libxml2-dev
    rm -rf /var/lib/apt/lists/*

    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip
    /opt/venv/bin/pip install --no-cache-dir numpy skyfield
    mkdir -p /results

    # A Sonic checkout may be flat: ~/leosim itself is ns-3 and contains the
    # `ns3` launcher plus contrib/. Normalize that copied layout to the runtime
    # path /opt/leosim/ns3 expected by the batch job.
    if [ -f /opt/leosim/ns3 ] && [ -d /opt/leosim/contrib/leosim ]; then
        mkdir -p /opt/leosim-flat-ns3
        find /opt/leosim -mindepth 1 -maxdepth 1 \
            -exec mv -t /opt/leosim-flat-ns3 -- {} +
        mv /opt/leosim-flat-ns3 /opt/leosim/ns3
    fi

    # Prefer a local ns-3 checkout in the user's home (if available), otherwise
    # fall back to /opt/leosim/ns3 or clone upstream.
    HOST_NS3="/home/people/adesilva/leosim/ns3"
    if [ -d "$HOST_NS3" ]; then
        mkdir -p /opt/leosim
        cp -a "$HOST_NS3" /opt/leosim/ns3
    fi

    if [ ! -d /opt/leosim/ns3 ]; then
        git clone https://gitlab.com/nsnam/ns-3-dev.git /opt/leosim/ns3
    fi

    # If the LeoSim module is not already under ns-3/contrib, install it there.
    if [ -d /opt/leosim/examples ] && [ ! -d /opt/leosim/ns3/contrib/leosim ]; then
        mkdir -p /opt/leosim/ns3/contrib/leosim
        cd /opt/leosim
        tar --exclude=ns3 -cf - . | tar -C /opt/leosim/ns3/contrib/leosim -xf -
    fi

    cd /opt/leosim/ns3
    if [ -x ./ns3 ]; then
        ./ns3 configure --enable-examples --disable-tests --build-profile=optimized
        ./ns3 build leosim-experiments
    elif [ -x ./waf ]; then
        ./waf configure --enable-examples --disable-tests --build-profile=optimized
        ./waf build
    else
        echo "No ns-3 build wrapper found (./ns3 or ./waf)." >&2
        exit 1
    fi

    # The parameterized scenario's route-tree cache invokes this standalone
    # process at runtime. Build it inside the image so its ABI matches the
    # container rather than relying on a host-compiled binary copied by %files.
    make -C /opt/leosim/ns3/contrib/leosim/utils/rengine clean all
    make -C /opt/leosim/ns3/contrib/leosim/utils/rengine self-test

%environment
    export PATH="/opt/venv/bin:$PATH"

%runscript
    # At runtime prefer mounted or copied home ns-3 at ~/leosim/ns3 if present
    if [ -d "$HOME/leosim/ns3" ]; then
        cd "$HOME/leosim/ns3"
    else
        cd /opt/leosim/ns3
    fi
    exec ./ns3 "$@"

%test
    /opt/venv/bin/python -c 'import numpy, skyfield'
    if [ -d "$HOME/leosim/ns3" ]; then
        cd "$HOME/leosim/ns3"
    else
        cd /opt/leosim/ns3
    fi
    test -x contrib/leosim/utils/rengine/leosim-rengine
    contrib/leosim/utils/rengine/leosim-rengine --self-test
    ./ns3 run "leosim-experiments --PrintHelp" --no-build |
        grep -q -- "--useRouteTreeCache"
    ./ns3 run "leosim-experiments --PrintHelp" --no-build |
        grep -q -- "--routeTreeEngine"
    ./ns3 run "leosim-experiments --PrintHelp" --no-build |
        grep -q -- "--routeTreeWorkers"
